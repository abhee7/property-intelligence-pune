DATABASE_URL="file:./dev.db"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="dev-access-secret-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="dev-refresh-secret-change-in-production-min-32-chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PROVIDER_OCR="tesseract"
OCR_LANGS="eng+mar"
OCR_MAX_PDF_PAGES="8"
PROVIDER_GOV_RECORDS="mock"
PROVIDER_COURT_RECORDS="mock"
PROVIDER_NEWS="mock"
PROVIDER_AI_AGENT="mock"
PROVIDER_NOTIFICATION="mock"
PROVIDER_RISK_ENGINE="mock"
PROVIDER_STORAGE="local"
PROVIDER_VERIFICATION="mock"

# ── Optional: AI features (see README → "AI features") ──
# Leave every key empty and everything still works (rule-based summaries, Tesseract OCR).
# Use ONE of the two providers. With both set, Claude is used unless AI_PROVIDER says otherwise.
GEMINI_API_KEY=""                      # Google Gemini — get a key at https://aistudio.google.com/apikey
# GEMINI_MODEL="gemini-2.5-flash"      # default; e.g. gemini-2.5-pro for higher quality
ANTHROPIC_API_KEY=""                   # Anthropic Claude
# ANTHROPIC_MODEL="claude-opus-5-5"    # e.g. claude-sonnet-5-5 for lower cost
# AI_PROVIDER="auto"                   # auto (whichever key is set) | gemini | claude
AI_NARRATIVES="manual"                 # off | manual (button / script) | auto (also after document & match events)
AI_SCAN_READING="fallback"             # off | fallback (only when Tesseract is unsure) | always
AI_TRANSLITERATION="auto"              # off | auto (the AI model spells Marathi names in English; the rule-based reader always runs)
# AI_REFUSAL_FALLBACKS="on"
# AI_TIMEOUT_MS="90000"
