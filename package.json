{
  "name": "propintel",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Property Intelligence Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "setup": "bash scripts/setup.sh",
    "dataset:import": "tsx prisma/import-pune-dataset.ts",
    "dataset:documents": "tsx --conditions=react-server prisma/generate-sample-documents.ts",
    "risk:recompute": "tsx scripts/recompute-risk.ts",
    "smoke:risk": "node scripts/smoke-matching-risk.cjs",
    "demo:docs": "node scripts/make-demo-docs.cjs",
    "ocr:setup": "node scripts/download-ocr-data.mjs eng mar",
    "ocr:samples": "node scripts/make-sample-docs.mjs sample-docs",
    "ocr:try": "tsx scripts/ocr-try.ts",
    "ai:check": "tsx scripts/ai-check.ts",
    "risk:narratives": "tsx scripts/generate-narratives.ts",
    "smoke:standalone": "node scripts/smoke-standalone.cjs",
    "docker:up": "docker compose up --build"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@google/genai": "^3.3.0",
    "@hyzyla/pdfium": "^3.0.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "6.19.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "next": "^15.0.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^2.13.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tesseract.js": "^5.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "@types/bcrypt": "^5.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.0",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
